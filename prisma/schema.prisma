datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         String   @id @default(cuid())
  name       String?
  email      String   @unique
  password   String?
  createdAt  DateTime @default(now())
  notes      FieldNote[]
}

model FieldNote {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  text        String
  fieldType   String
  mood        String?
  energy      String?
  attachments String?
  timestamp   DateTime @default(now())
}
