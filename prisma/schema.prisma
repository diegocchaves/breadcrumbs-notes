datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id    String      @id @default(cuid())
  email String      @unique
  password String
  notes FieldNote[]
}

enum FieldType {
  Insight
  Encounter
  Mood
  Energy
  Thoughts
  Other
}

model FieldNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  text      String
  fieldType FieldType
  createdAt DateTime @default(now())
}
